# EventSphere Management — Environment Configuration
PORT=3000

# Security Secrets (auto-generated into .data/.runtime-secrets.json in local/preview mode if omitted)
JWT_SECRET=
DATA_ENCRYPTION_KEY=
ORGANIZER_SETUP_CODE=

# Database (optional — falls back to local JSON storage in .data/ when omitted)
MONGODB_URI=
EVENTSPHERE_DISABLE_MONGO=

# Gemini AI Concierge (server-side only)
GEMINI_API_KEY=

# Optional Firebase / Google Auth
FIREBASE_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Optional Frontend / CORS / HTTPS
VITE_API_BASE_URL=
CLIENT_ORIGIN=
FORCE_HTTPS=

# Optional SMTP / Email Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
BREVO_USER=
BREVO_FROM_EMAIL=
